# Example values only. Never commit working credentials.
DATABASE_URL=sqlite:///./learningx_dev.sqlite3
NIT_STORAGE_DIR=./private_lessons
NIT_ENGINE_ROOT=/absolute/path/to/frozen-nit-engine
NIT_JWT_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_MIN_32_CHARS
NIT_REVIEW_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
NIT_LLM_BASE_URL=https://provider.example/v1
NIT_LLM_MODEL=auto
NIT_LLM_API_KEY=REPLACE_ON_SERVER

# Optional Neon private S3 artifact store; required for serverless document uploads.
# Generate a branch-scoped credential in Neon and store it ONLY on the backend host.
NIT_STORAGE_BUCKET=learningx-private-lessons
AWS_ENDPOINT_URL_S3=https://YOUR_NEON_BRANCH.storage.YOUR_REGION.neon.tech
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_NEON_BRANCH_CREDENTIAL_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_NEON_BRANCH_CREDENTIAL_SECRET
NIT_CORS_ORIGINS=https://learning-x-one.vercel.app

# Internal worker dispatcher secret; do not reuse JWT or faculty signing keys.
NIT_WORKER_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARS

# Enable only after provisioning a Vercel project with Python Queue subscriber.
NIT_QUEUE_ENABLED=0

# Select ONE dispatcher; only Vercel Queues is currently wired as a private subscriber.
NIT_WORKER_BACKEND=vercel_queue
